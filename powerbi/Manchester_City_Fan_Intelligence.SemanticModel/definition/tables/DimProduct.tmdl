table 'DimProduct'

	column 'ProductID'
		dataType: int64
		isKey
		summarizeBy: none
		sourceColumn: ProductID

	column 'ProductName'
		dataType: string
		summarizeBy: none
		sourceColumn: ProductName

	column 'Category'
		dataType: string
		summarizeBy: none
		sourceColumn: Category

	column 'ListPriceGBP'
		dataType: int64
		summarizeBy: none
		sourceColumn: ListPriceGBP

	column 'DataNature'
		dataType: string
		summarizeBy: none
		sourceColumn: DataNature

	partition 'DimProduct-Import' = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(#"DataRoot" & "\synthetic_microdata\dim_product.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"ProductID", Int64.Type}, {"ProductName", type text}, {"Category", type text}, {"ListPriceGBP", Int64.Type}, {"DataNature", type text}})
				in
					Typed
