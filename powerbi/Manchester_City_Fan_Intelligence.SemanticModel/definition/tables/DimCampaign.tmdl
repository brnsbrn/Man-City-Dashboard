table 'DimCampaign'

	column 'CampaignID'
		dataType: int64
		isKey
		summarizeBy: none
		sourceColumn: CampaignID

	column 'CampaignName'
		dataType: string
		summarizeBy: none
		sourceColumn: CampaignName

	column 'Objective'
		dataType: string
		summarizeBy: none
		sourceColumn: Objective

	column 'PrimaryChannel'
		dataType: string
		summarizeBy: none
		sourceColumn: PrimaryChannel

	column 'StartDate'
		dataType: dateTime
		summarizeBy: none
		sourceColumn: StartDate

	column 'EndDate'
		dataType: dateTime
		summarizeBy: none
		sourceColumn: EndDate

	column 'DataNature'
		dataType: string
		summarizeBy: none
		sourceColumn: DataNature

	partition 'DimCampaign-Import' = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(#"DataRoot" & "\synthetic_microdata\dim_campaign.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"CampaignID", Int64.Type}, {"CampaignName", type text}, {"Objective", type text}, {"PrimaryChannel", type text}, {"StartDate", type datetime}, {"EndDate", type datetime}, {"DataNature", type text}})
				in
					Typed
