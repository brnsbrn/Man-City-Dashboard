table 'DimMatch'

	column 'MatchID'
		dataType: int64
		isKey
		summarizeBy: none
		sourceColumn: MatchID

	column 'MatchDate'
		dataType: dateTime
		summarizeBy: none
		sourceColumn: MatchDate

	column 'Season'
		dataType: string
		summarizeBy: none
		sourceColumn: Season

	column 'Competition'
		dataType: string
		summarizeBy: none
		sourceColumn: Competition

	column 'Opponent'
		dataType: string
		summarizeBy: none
		sourceColumn: Opponent

	column 'Result'
		dataType: string
		summarizeBy: none
		sourceColumn: Result

	column 'MatchCategory'
		dataType: string
		summarizeBy: none
		sourceColumn: MatchCategory

	column 'Venue'
		dataType: string
		summarizeBy: none
		sourceColumn: Venue

	column 'AttendanceEstimate'
		dataType: int64
		summarizeBy: none
		sourceColumn: AttendanceEstimate

	column 'TicketsSoldEstimate'
		dataType: int64
		summarizeBy: none
		sourceColumn: TicketsSoldEstimate

	partition 'DimMatch-Import' = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(#"DataRoot" & "\synthetic_microdata\dim_match.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"MatchID", Int64.Type}, {"MatchDate", type datetime}, {"Season", type text}, {"Competition", type text}, {"Opponent", type text}, {"Result", type text}, {"MatchCategory", type text}, {"Venue", type text}, {"AttendanceEstimate", Int64.Type}, {"TicketsSoldEstimate", Int64.Type}})
				in
					Typed
